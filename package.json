{
  "name": "central-user-service",
  "version": "1.0.0",
  "description": "Central login service for Wockhardt field users (NSM / ZSM / RM / TM): email OTP, RS256 tokens for client apps",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node db/init.js",
    "db:seed-online": "node db/seed-from-online.js",
    "client:add": "node db/add-client.js",
    "db:import-staff": "node db/import-staff.js",
    "db:sync-synapse": "node db/sync-synapse.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.4",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1"
  }
}
