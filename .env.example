# Central User Service — copy to .env and fill in.

PORT=5020
# Public URL of this service. It becomes the token issuer ("iss"); client apps check it.
PUBLIC_URL=http://localhost:5020

# This service's own database (created by `npm run db:init`).
DATABASE_URL=postgres://postgres:<password>@127.0.0.1:5432/central_user_db

# Online (D2D) database, used read-only by `npm run db:seed-online` to copy the field structure.
SOURCE_DATABASE_URL=postgres://postgres:<password>@192.168.1.76:5432/d2d_portal

# OTP: email (production) or console (local testing: OTP is printed in the log, no email is sent).
OTP_DELIVERY=email
OTP_EXPIRY_MINUTES=10
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Mail relay (same as BIONX PULSE / Regen). SMTP_SECURE=false = internal relay without login.
SMTP_HOST=192.168.3.9
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Wockhardt Field Login <WockRegenerative@wockhardt.com>

# Infinity field-structure API (as in the Online project).
INFINITY_REPORT_BASE_URL=https://infinityplus.wockhardt.com/plus/report
INFINITY_API_HEADER_NAME=
INFINITY_API_TOKEN=

# First admin account for the /admin page (created / updated by `npm run db:init`).
ADMIN_NAME=
ADMIN_MOBILE=
ADMIN_EMAIL=

# Optional: extra browser origins allowed to call /api/auth (besides each client's allowed origins).
CORS_ORIGINS=
# Number of reverse proxies in front (Apache = 1).
TRUST_PROXY=1
# Signing keys folder (default ./keys). Keep keys/private.pem across deployments.
# KEYS_DIR=

# Azure Synapse (WH_SAPdataAnalytics): read-only source of Infinity's field structure (dbo.Field_Structure).
SYNAPSE_SERVER=<server>.sql.azuresynapse.net
SYNAPSE_DATABASE=<database>
SYNAPSE_USER=<user>
SYNAPSE_PASSWORD=<password>
SYNAPSE_ENCRYPT=true
